{
  "name": "@sudoplatform/sudo-secure-id-verification",
  "version": "9.1.0",
  "author": "Anonyome Labs, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sudoplatform/sudo-secure-id-verification-js.git"
  },
  "license": "Apache-2.0",
  "scripts": {
    "prepare": "husky",
    "lint": "yarn lint:eslint && yarn lint:prettier",
    "lint:eslint": "eslint \"{bin,test,src}/**/*.{js,ts,tsx}\"",
    "lint:prettier": "prettier -l \"{bin,test,src}/**/*.{js,json,ts,yml}\"",
    "codegen": "graphql-codegen -c codegen.yml",
    "audit-with-suppressions": "yarn dlx -p @anonyome/platform-build-tools audit-with-suppressions",
    "verify": "true",
    "test": "yarn unit-test",
    "unit-test": "vitest run --coverage test/unit",
    "integration-test": "vitest run test/integration",
    "smoketest": "yarn unit-test && vitest run test/integration --testNamePattern='smoke_'",
    "clean": "rm -rf esm lib docs types src/gen",
    "build": "yarn codegen && yarn build:nocodegen",
    "build:nocodegen": "yarn verify && yarn build:transpile && yarn build:docs",
    "build:transpile": "concurrently \"yarn build:transpile:declarations\" \"yarn build:transpile:cjs\" \"yarn build:transpile:esm\"",
    "build:transpile:cjs": "tsc --project tsconfig.commonjs.json",
    "build:transpile:esm": "tsc",
    "build:transpile:declarations": "tsc --project tsconfig.declarations.json",
    "build:docs": "typedoc --excludePrivate --out docs src/index.ts"
  },
  "main": "./cjs/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./lib/index.js",
      "require": "./cjs/index.js",
      "default": "./lib/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "cjs",
    "lib",
    "types"
  ],
  "browser": {
    "./lib/runtimes/node/node-crypto.js": "./lib/runtimes/browser/browser-crypto.js"
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "^3.2.0",
    "fp-ts": "^2.16.11",
    "graphql": "^16.12.0",
    "io-ts": "^2.2.22",
    "tslib": "^2.8.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.3",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/add": "^6.0.0",
    "@graphql-codegen/cli": "^6.1.0",
    "@graphql-codegen/typed-document-node": "^6.1.3",
    "@graphql-codegen/typescript": "^5.0.5",
    "@graphql-codegen/typescript-operations": "^5.0.5",
    "@sudoplatform/sudo-api-client": "^16.0.0",
    "@sudoplatform/sudo-common": "^12.2.0",
    "@sudoplatform/sudo-entitlements": "^18.0.0",
    "@sudoplatform/sudo-entitlements-admin": "^13.0.0",
    "@sudoplatform/sudo-user": "^17.1.0",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "@vitest/coverage-v8": "2.1.9",
    "@vitest/ui": "^2.1.8",
    "concurrently": "^9.2.1",
    "core-js": "^3.47.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-tree-shaking": "^1.12.2",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "node-fetch": "^2.7.0",
    "prettier": "^3.6.2",
    "ts-mockito": "^2.6.1",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.14",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  },
  "resolutions": {
    "@babel/helpers": "^7.26.10",
    "@babel/runtime": "^7.26.10",
    "@smithy/config-resolver": "^4.4.9",
    "@sudoplatform/sudo-user": "^17.1.0",
    "cross-spawn": "^7.0.5",
    "esbuild": "^0.27.3",
    "fast-xml-parser": "^5.4.1",
    "graphql": "^16.12.0",
    "string-width": "^4.2.3",
    "strip-ansi": "^6.0.1",
    "tmp": "^0.2.4"
  },
  "peerDependencies": {
    "@sudoplatform/sudo-api-client": "^16.0.0",
    "@sudoplatform/sudo-common": "^12.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@4.13.0+sha512.5c20ba010c99815433e5c8453112165e673f1c7948d8d2b267f4b5e52097538658388ebc9f9580656d9b75c5cc996f990f611f99304a2197d4c56d21eea370e7"
}
